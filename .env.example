# Copy to .env and fill in. Never commit .env.
# Anything left blank is skipped: Tempo routes around missing services.

# --- OpenRouter (cloud tiers) -- https://openrouter.ai/keys
# Set this and the light/large tiers and embeddings go through OpenRouter (the Gemini keys
# below are then ignored for chat). Defaults are the same Gemini models, at the same prices.
OPENROUTER_API_KEY=
OPENROUTER_LIGHT_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_LARGE_MODEL=google/gemini-2.5-flash
OPENROUTER_EMBED_MODEL=google/gemini-embedding-001

# --- Gemini direct (cloud tiers, if no OpenRouter key) -- https://aistudio.google.com/apikey
GEMINI_API_KEY_1=
# Optional extra keys (separate AI Studio projects) to spread free-tier limits:
GEMINI_API_KEY_2=
GEMINI_LIGHT_MODEL=gemini-2.5-flash-lite
GEMINI_LARGE_MODEL=gemini-2.5-flash
# Thinking tokens for the large model ("none" to omit the setting entirely)
LARGE_THINKING_BUDGET=512

# --- Local model (Ollama, optional) -- https://ollama.com/download
# Blank = API-only: no local model, and personal data is redacted before any cloud call.
# To run locally instead: ollama pull llama3.2:3b, then set OLLAMA_MODEL=llama3.2:3b
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=

# --- Embeddings for the private document index: gemini | openrouter | ollama | hash
# gemini with only an OpenRouter key uses OPENROUTER_EMBED_MODEL.
# EMBED_MODEL is only read by ollama (e.g. nomic-embed-text).
EMBED_PROVIDER=gemini
EMBED_MODEL=nomic-embed-text

# --- Web search (Tavily, free tier) -- https://app.tavily.com
TAVILY_API_KEY=

# --- Tiger Cloud (vector search + telemetry). Blank = in-memory index + results/telemetry.jsonl
DATABASE_URL=

# --- Tuning (run `python -m scripts.calibrate` to pick RETRIEVAL_THRESHOLD)
RETRIEVAL_THRESHOLD=0.55
CONFIDENCE_THRESHOLD=0.6

# --- List prices in USD per 1M tokens, for cost reporting (check ai.google.dev/pricing)
PRICE_LIGHT_IN=0.10
PRICE_LIGHT_OUT=0.40
PRICE_LARGE_IN=0.30
PRICE_LARGE_OUT=2.50
